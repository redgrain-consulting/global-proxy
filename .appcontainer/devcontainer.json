{
  // Apple Container Manager dev container for the global Caddy proxy.
  // Docs: https://marketplace.visualstudio.com/items?itemName=Awei-Sumaho.apple-container-manager
  //
  // The extension bind-mounts this repo at "workspaceFolder", injects an SSH key
  // and connects over Remote-SSH — so one forwarded port must map to :22. It only
  // understands a subset of the devcontainer spec (build, remoteUser,
  // workspaceFolder, runArgs, containerEnv, mounts, forwardPorts, post*Command,
  // hostRequirements) — there is no dockerComposeFile / features / customizations.
  // Keep comments on their own lines: the extension cannot strip trailing ones.
  //
  // Upstreams: Apple Container has no shared compose network, so Caddy reaches
  // the app containers by name through Apple's embedded DNS, as
  // <container-name><UPSTREAM_SUFFIX>. That needs a one-time
  //   sudo container system dns create container.acm
  // plus `[dns] domain = "container.acm"` in ~/.config/container/config.toml
  // (container 1.5.0 has no `system property set`), then
  //   container system stop && container system start
  // Each app container must be (re)created afterwards so it registers under the
  // domain. The gateway resolver caches misses, so a name looked up before its
  // container existed can stay NXDOMAIN for a while.
  "name": "global-proxy",
  "build": {
    // Both paths are relative to this file's folder (extension >= 0.9.7, per the
    // devcontainer spec), so "." keeps the build context to .appcontainer/ only.
    "context": ".",
    "dockerfile": "Dockerfile",
    // Pin public resolvers for the build (apt-get). Apple's embedded DNS (the
    // vmnet gateway, 192.168.64.1) only comes up when macOS's mDNSResponder can
    // bind the wildcard *:53; a local resolver already on port 53 (dnsmasq,
    // Zscaler, etc.) blocks that bind and leaves the gateway dead
    // (apple/container#402). Pinning keeps the build resolving regardless.
    "options": ["--dns", "1.1.1.1", "--dns", "8.8.8.8"]
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/global-proxy",
  // No --dns pin at runtime, unlike the app containers: Caddy must use Apple's
  // embedded resolver (the default) to look up the other containers by name.
  "runArgs": ["--ssh"],
  // 80/443 (+ UDP 443 for HTTP/3) and 6006 match docker-compose.yml. Each
  // container needs a unique host port for SSH — catalyst holds 2222 and
  // statamic 2223 — so the SSH mapping must stay explicit.
  "forwardPorts": [80, 443, "443:443/udp", 6006, "2224:22"],
  "hostRequirements": {
    "cpus": 2,
    "memory": "256mb"
  },
  "containerEnv": {
    "UPSTREAM_SUFFIX": ".container.acm"
  },
  "postStartCommand": "bash /workspaces/global-proxy/.appcontainer/start.sh"
}
